# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# API processes sharing the port (one per CPU core in production)
API_WORKERS=1
DATABASE_URL=postgresql://fr:fr@localhost:5432/fashion_rockstar?schema=public
REDIS_URL=redis://localhost:6379
# bullmq (Redis-backed, run `pnpm --filter @fr/api worker`) or inline (single process)
QUEUE_MODE=bullmq
WEB_ORIGIN=http://localhost:3000

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ── Sessions & MFA ───────────────────────────────────────────────────
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Require MFA enrolment for privileged roles (owner, approver, finance). Always true in production.
MFA_ENFORCE_FOR_PRIVILEGED=false

# ── Demonstration mode (never in production) ─────────────────────────
DEMO_MODE=false

# ── Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Seed (first run only) ──────────────────────────────────────────────
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner

# ── Public URL & mock mode ─────────────────────────────────────────────
# Public HTTPS URL of this API: OAuth callbacks and signed image links marketplaces download.
PUBLIC_BASE_URL=http://localhost:4000
# Route every marketplace/supplier connector to the local mock server (`pnpm --filter @fr/api mock`).
# Dummy data only. Never allowed in production.
MOCK_MARKETPLACES=false
MOCK_BASE_URL=http://localhost:4100

# ── eBay (one developer app covers eBay UK and eBay USA) ───────────────
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName whose "auth accepted URL" is <PUBLIC_BASE_URL>/api/integrations/oauth/ebay/callback
EBAY_RU_NAME=
# Digital-signature key pair from eBay's Key Management API (Finances API for UK/EU sellers).
EBAY_SIGNING_KEY_JWE=
EBAY_SIGNING_PRIVATE_KEY=

# ── Amazon Selling Partner API ─────────────────────────────────────────
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_APP_ID=

# ── TikTok Shop Partner Center ─────────────────────────────────────────
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# ── Suppliers ──────────────────────────────────────────────────────────
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
CJ_API_KEY=

# ── AI listing assistant (Claude API) ──────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Dashboard / report aggregates cache (seconds, 0 = always live)
AGGREGATE_CACHE_SECONDS=60

# ── Background schedule (minutes; 0 disables) ──────────────────────────
SYNC_ORDERS_EVERY_MIN=10
SYNC_FINANCE_EVERY_MIN=60
SYNC_INVENTORY_EVERY_MIN=15
SYNC_SUPPLIERS_EVERY_MIN=360
