# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fr:fr@localhost:5432/fashion_rockstar?schema=public
REDIS_URL=redis://localhost:6379
# bullmq (Redis-backed, run `pnpm --filter @fr/api worker`) or inline (single process)
QUEUE_MODE=bullmq
WEB_ORIGIN=http://localhost:3000

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ── Sessions & MFA ───────────────────────────────────────────────────
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Require MFA enrolment for privileged roles (owner, approver, finance). Always true in production.
MFA_ENFORCE_FOR_PRIVILEGED=false

# ── Demonstration mode (never in production) ─────────────────────────
DEMO_MODE=false

# ── Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Seed (first run only) ──────────────────────────────────────────────
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner
