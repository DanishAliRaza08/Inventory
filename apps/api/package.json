{
  "name": "@fr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "mock": "ts-node --transpile-only src/mock/main-mock.ts",
    "demo": "ts-node --transpile-only src/demo/main-demo.ts",
    "load:data": "ts-node --transpile-only scripts/load-data.ts",
    "load:test": "ts-node --transpile-only scripts/load-test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "vitest run",
    "openapi": "ts-node --transpile-only scripts/export-openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fr/core": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.0",
    "bullmq": "5.58.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.6.0",
    "csv-stringify": "6.6.0",
    "decimal.js": "10.4.3",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "fast-xml-parser": "4.5.0",
    "helmet": "8.1.0",
    "image-size": "1.2.1",
    "ioredis": "5.7.0",
    "multer": "2.0.2",
    "otplib": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.7",
    "vitest": "2.1.8"
  }
}
